import("../../../usbmgr.gni")

config("ohusb_manager_config") {
  include_dirs = [ "${usb_manager_path}/interfaces/kits/capi/include" ]
}

ohos_shared_library("ohusb_manager") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    boundary_sanitize = true
    debug = false
    integer_overflow = true
    ubsan = true
  }
  branch_protector_ret = "pac_ret"

  public_configs = [ ":ohusb_manager_config" ]

  sources = [ "./src/ohusb_manager.cpp" ]

  include_dirs = [
    "${usb_manager_path}/interfaces/innerkits/native/include",
    "${usb_manager_path}/utils/native/include",
    "${usb_manager_path}/interfaces/kits/capi/include",
  ]

  deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  output_name = "ohusb_manager"
  output_extension = "so"
  relative_install_dir = "ndk"

  subsystem_name = "usb"
  part_name = "usb_manager"
}
