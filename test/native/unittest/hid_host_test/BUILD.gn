import("//build/test.gni")
import("./../../../../usbmgr.gni")

module_output_path = "${usb_manager_part_name}/usb_unittest_test"

#
# Self-contained HID (keyboard / mouse) host test.
#
# This directory is intentionally standalone: it carries its own BUILD.gn so
# the test can be built without touching the sibling service_unittest/BUILD.gn.
# It reuses the shared usb_common_test.cpp (permission bootstrap helper) by
# referencing it as a source path rather than modifying it.
#
# Build with:
#   ./build.sh --product-name <product> \
#     --build-target //base/usb/usb_manager/test/native/unittest/hid_host_test:test_usbhidhost
#
config("hid_host_test_private_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "include",
    "${usb_manager_path}/test/native/service_unittest/include",
  ]
}

hid_host_test_common_sources = [
  "${usb_manager_path}/test/native/service_unittest/src/usb_common_test.cpp",
  "src/usb_hid_host_test.cpp",
]

hid_host_test_external_deps = [
  "ability_base:want",
  "access_token:libaccesstoken_sdk",
  "access_token:libnativetoken",
  "access_token:libtoken_setproc",
  "bundle_framework:appexecfwk_base",
  "c_utils:utils",
  "common_event_service:cesfwk_innerkits",
  "drivers_interface_usb:libusb_proxy_1.0",
  "eventhandler:libeventhandler",
  "googletest:gtest_main",
  "hilog:libhilog",
  "ipc:ipc_core",
  "safwk:system_ability_fwk",
  "samgr:samgr_proxy",
]

if (usb_manager_feature_host) {
  ohos_unittest("test_usbhidhost") {
    module_out_path = module_output_path
    install_enable = false
    sources = hid_host_test_common_sources
    configs = [
      "${utils_path}:utils_config",
      ":hid_host_test_private_config",
    ]
    deps = [
      "${usb_manager_path}/interfaces/innerkits:usbsrv_client",
    ]
    external_deps = hid_host_test_external_deps
  }

  group("hid_host_test") {
    testonly = true
    deps = [ ":test_usbhidhost" ]
  }
}