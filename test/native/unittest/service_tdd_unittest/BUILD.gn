import("//build/test.gni")
import("./../../../usbmgr.gni")

module_output_path = "${usb_manager_part_name}/usb_unittest_test"

config("service_tdd_private_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "include",
    "${usb_manager_path}/test/native/service_unittest/include",
  ]
}

service_tdd_external_deps = [
  "ability_base:want",
  "access_token:libaccesstoken_sdk",
  "access_token:libnativetoken",
  "access_token:libtoken_setproc",
  "bundle_framework:appexecfwk_base",
  "c_utils:utils",
  "common_event_service:cesfwk_innerkits",
  "drivers_interface_usb:libusb_proxy_1.0",
  "eventhandler:libeventhandler",
  "googletest:gtest_main",
  "hilog:libhilog",
  "ipc:ipc_core",
  "safwk:system_ability_fwk",
  "samgr:samgr_proxy",
]

service_tdd_test_sources = [
  "${usb_manager_path}/test/native/service_unittest/src/usb_common_test.cpp",
  "src/usb_service_tdd_test.cpp",
]

service_tdd_test_configs = [
  "${utils_path}:utils_config",
  ":service_tdd_private_config",
]

service_tdd_test_deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]

# Feature macros must mirror the usbsrv_client build so the #ifdef guards in
# the test source match the API set compiled into the client library.
service_tdd_defines = []
if (usb_manager_feature_host) {
  service_tdd_defines += [ "USB_MANAGER_FEATURE_HOST" ]
}
if (usb_manager_feature_device) {
  service_tdd_defines += [ "USB_MANAGER_FEATURE_DEVICE" ]
}
if (usb_manager_feature_port) {
  service_tdd_defines += [ "USB_MANAGER_FEATURE_PORT" ]
}

ohos_unittest("test_usb_service_tdd") {
  module_out_path = module_output_path
  install_enable = false
  sources = service_tdd_test_sources
  configs = service_tdd_test_configs
  defines = service_tdd_defines
  deps = service_tdd_test_deps
  external_deps = service_tdd_external_deps
}

group("service_tdd_unittest") {
  testonly = true
  deps = [ ":test_usb_service_tdd" ]
}
