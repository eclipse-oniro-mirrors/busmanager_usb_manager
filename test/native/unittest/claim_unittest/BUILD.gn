import("//build/test.gni")
import("./../../../../usbmgr.gni")

module_output_path = "${usb_manager_part_name}/usb_unittest_test"

config("claim_unittest_private_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "include",
    "${usb_manager_path}/test/native/service_unittest/include",
  ]
}

claim_unittest_common_sources = [
  "${usb_manager_path}/test/native/service_unittest/src/usb_common_test.cpp",
  "src/usb_claim_test_common.cpp",
]

claim_unittest_external_deps = [
  "ability_base:want",
  "access_token:libaccesstoken_sdk",
  "access_token:libnativetoken",
  "access_token:libtoken_setproc",
  "bundle_framework:appexecfwk_base",
  "c_utils:utils",
  "common_event_service:cesfwk_innerkits",
  "drivers_interface_usb:libusb_proxy_1.0",
  "eventhandler:libeventhandler",
  "googletest:gtest_main",
  "hilog:libhilog",
  "ipc:ipc_core",
  "safwk:system_ability_fwk",
  "samgr:samgr_proxy",
]

if (usb_manager_feature_host) {
  ohos_unittest("test_claim_exclusive") {
    module_out_path = module_output_path
    install_enable = false
    sources = claim_unittest_common_sources
    sources += [ "src/usb_claim_exclusive_test.cpp" ]
    configs = [
      "${utils_path}:utils_config",
      ":claim_unittest_private_config",
    ]
    deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]
    external_deps = claim_unittest_external_deps
  }

  ohos_unittest("test_claim_release") {
    module_out_path = module_output_path
    install_enable = false
    sources = claim_unittest_common_sources
    sources += [ "src/usb_claim_release_test.cpp" ]
    configs = [
      "${utils_path}:utils_config",
      ":claim_unittest_private_config",
    ]
    deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]
    external_deps = claim_unittest_external_deps
  }

  # Standalone exclusive claim holder used by the death test suite (stage1).
  # Deploy it to /data/claim_notify_probe before running test_claim_death.
  ohos_executable("claim_notify_probe") {
    testonly = true
    install_enable = false
    sanitize = {
      cfi = true
      cfi_cross_dso = true
      debug = false
    }
    sources = [ "src/claim_notify_probe.cpp" ]
    configs = [
      "${utils_path}:utils_config",
      ":claim_unittest_private_config",
    ]
    deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]
    external_deps = [
      "access_token:libaccesstoken_sdk",
      "access_token:libnativetoken",
      "access_token:libtoken_setproc",
      "c_utils:utils",
      "hilog:libhilog",
      "ipc:ipc_core",
    ]
    subsystem_name = "usb"
    part_name = "usb_manager"
  }

  ohos_unittest("test_claim_notify") {
    module_out_path = module_output_path
    install_enable = false
    sources = claim_unittest_common_sources
    sources += [ "src/usb_claim_notify_test.cpp" ]
    configs = [
      "${utils_path}:utils_config",
      ":claim_unittest_private_config",
    ]
    deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]
    external_deps = claim_unittest_external_deps
  }

  ohos_unittest("test_claim_transfer") {
    module_out_path = module_output_path
    install_enable = false
    sources = claim_unittest_common_sources
    sources += [ "src/usb_claim_transfer_test.cpp" ]
    configs = [
      "${utils_path}:utils_config",
      ":claim_unittest_private_config",
    ]
    deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]
    external_deps = claim_unittest_external_deps
  }

  ohos_unittest("test_claim_hotplug") {
    module_out_path = module_output_path
    install_enable = false
    sources = claim_unittest_common_sources
    sources += [ "src/usb_claim_hotplug_test.cpp" ]
    configs = [
      "${utils_path}:utils_config",
      ":claim_unittest_private_config",
    ]
    deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]
    external_deps = claim_unittest_external_deps
  }

  ohos_unittest("test_claim_force") {
    module_out_path = module_output_path
    install_enable = false
    sources = claim_unittest_common_sources
    sources += [ "src/usb_claim_force_test.cpp" ]
    configs = [
      "${utils_path}:utils_config",
      ":claim_unittest_private_config",
    ]
    deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]
    external_deps = claim_unittest_external_deps
  }

  ohos_unittest("test_claim_multi_device") {
    module_out_path = module_output_path
    install_enable = false
    sources = claim_unittest_common_sources
    sources += [ "src/usb_claim_multi_device_test.cpp" ]
    configs = [
      "${utils_path}:utils_config",
      ":claim_unittest_private_config",
    ]
    deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]
    external_deps = claim_unittest_external_deps
  }

  ohos_unittest("test_claim_death") {
    module_out_path = module_output_path
    install_enable = false
    sources = claim_unittest_common_sources
    sources += [ "src/usb_claim_death_test.cpp" ]
    configs = [
      "${utils_path}:utils_config",
      ":claim_unittest_private_config",
    ]
    deps = [ "${usb_manager_path}/interfaces/innerkits:usbsrv_client" ]
    external_deps = claim_unittest_external_deps
  }

  group("claim_unittest") {
    testonly = true
    deps = [
      ":test_claim_death",
      ":test_claim_exclusive",
      ":test_claim_force",
      ":test_claim_hotplug",
      ":test_claim_multi_device",
      ":test_claim_notify",
      ":test_claim_release",
      ":test_claim_transfer",
    ]
  }
}
